[Desktop Entry]
Type=Application
Name=Shotput
GenericName=Screenshot Tool
Comment=Screenshots for pasting: drag an area, it is on the clipboard
Exec=@BIN@ %U
Icon=io.github.shotput.Shotput
Terminal=false
Categories=Utility;Graphics;
Keywords=screenshot;capture;annotate;clipboard;
MimeType=x-scheme-handler/shotput;
StartupNotify=false
# KDE Plasma: lets Shotput take screenshots through KWin without a prompt each time.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
Actions=area;annotate;window;text;settings;

[Desktop Action area]
Name=Capture Area
Exec=@BIN@ area

[Desktop Action annotate]
Name=Capture Area and Annotate
Exec=@BIN@ annotate

[Desktop Action window]
Name=Capture Window
Exec=@BIN@ window

[Desktop Action text]
Name=Copy Text from Area
Exec=@BIN@ text

[Desktop Action settings]
Name=Settings
Exec=@BIN@ settings
